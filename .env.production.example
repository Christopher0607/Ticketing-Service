# Copy to .env.production on the server and fill in. Never commit the real file.
DOMAIN=crazymonkey.example
APP_URL=https://crazymonkey.example
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# 32+ random characters: openssl rand -hex 32
JOB_SECRET=

# manual = DuitNow QR / bank transfer with receipt upload (no gateway fees, start here)
# stripe = card / FPX through Stripe Connect (needs Stripe approval for ticket resale)
PAYMENT_MODE=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_ENABLE_FPX=false

# Required for sign-up verification and password reset (Resend has a free tier)
RESEND_API_KEY=
MAIL_FROM=Crazy Monkey <tickets@crazymonkey.example>

# Used once to create the first admin, then remove:
#   docker compose --env-file .env.production run --rm app node scripts/database.mjs admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

SUPPORT_WHATSAPP=60123456789
SUPPORT_EMAIL=support@crazymonkey.example
GROUPBUY_URL=
TERMS_URL=
PRIVACY_URL=
