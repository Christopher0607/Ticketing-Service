# Netlify (website) + Supabase (database and files) — all free plans.
# Fill this in, then in Netlify: Site configuration → Environment variables → Import from a .env file.
# Never commit the filled-in file.

# --- Website ---
APP_URL=https://www.your-domain.com
PAYMENT_MODE=manual
# 32+ random characters (e.g. run: openssl rand -hex 32)
JOB_SECRET=
# Netlify passes the visitor's IP in this header (used to rate-limit sign-ins)
CLIENT_IP_HEADER=x-nf-client-connection-ip

# --- Supabase database (Project Settings → Database → Connection string) ---
# App: "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Migrations at deploy time: "Session pooler" (port 5432)
DATABASE_MIGRATION_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Database → SSL Configuration → Download certificate, then paste the whole file (or its base64)
DATABASE_SSL_CA=

# --- Supabase Storage (Project Settings → API) ---
SUPABASE_URL=https://[project-ref].supabase.co
# service_role / secret key — server only, never share
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend: verify your domain first) ---
RESEND_API_KEY=
MAIL_FROM=Crazy Monkey <tickets@your-domain.com>
# Where operator alerts go (new receipts, seller applications, refunds)
ADMIN_NOTIFY_EMAIL=

# --- Contact and company (shown in the footer and legal pages) ---
SUPPORT_EMAIL=support@your-domain.com
SUPPORT_WHATSAPP=60123456789
COMPANY_NAME=
COMPANY_REG_NO=
COMPANY_ADDRESS=
GROUPBUY_URL=
# Set to true after your lawyer approves the Terms, Privacy and Refund pages
LEGAL_REVIEWED=false
