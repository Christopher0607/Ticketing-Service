DATABASE_URL=postgresql://ticketing:ticketing@127.0.0.1:5442/ticketing
# Optional: separate URL for migrations (Supabase session pooler) and a CA certificate for verified TLS
DATABASE_MIGRATION_URL=
DATABASE_SSL_CA=
APP_URL=http://localhost:3000
# demo (local only) | manual (DuitNow / bank transfer + receipt) | stripe (card / FPX via Stripe Connect)
PAYMENT_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_ENABLE_FPX=false
JOB_SECRET=local-demo-reconcile
# Optional Supabase Storage for posters, QR codes, receipts and proofs (otherwise stored in PostgreSQL)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Header carrying the visitor IP: x-real-ip behind Caddy/nginx, x-nf-client-connection-ip on Netlify
CLIENT_IP_HEADER=x-real-ip
# Verified sender domain required for real email verification, password reset and notifications.
RESEND_API_KEY=
MAIL_FROM=
ADMIN_NOTIFY_EMAIL=
# Set once to provision your first production administrator with npm run db:admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Public contacts and company details.
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
COMPANY_NAME=
COMPANY_REG_NO=
COMPANY_ADDRESS=
GROUPBUY_URL=
LEGAL_REVIEWED=false
