# Caddy obtains and renews the HTTPS certificate for $DOMAIN automatically.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000 {
		# The app rate-limits sign-ins by this header; always overwrite it with the real client address.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
